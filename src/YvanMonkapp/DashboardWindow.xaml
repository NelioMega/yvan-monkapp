<Window x:Class="YvanMonkapp.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YvanMonkapp.Controls"
        Title="Yvan Monk'app" Width="940" Height="790" MinWidth="780" MinHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}">

    <Border Margin="14" CornerRadius="18" Background="{StaticResource BoardBrush}"
            BorderBrush="{StaticResource WoodBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <!-- La photo de tableau passe par Background : c'est la seule couche qu'un Border
             rogne a son CornerRadius. Le voile par-dessus garde la craie lisible. -->
        <Border CornerRadius="17" Background="{StaticResource BoardPhotoBrush}">
        <Border CornerRadius="17" Background="#A61A2B24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- barre de titre maison -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragArea" Margin="22,16,16,0">
                <TextBlock Text="Yvan Monk'app" Foreground="{StaticResource ChalkBrush}"
                           FontFamily="{StaticResource ChalkFont}" FontSize="20" VerticalAlignment="Center" />
                <Button Content="✕" HorizontalAlignment="Right" Width="34" Height="30" Padding="0"
                        Style="{StaticResource GhostButton}" Click="OnClose" />
            </Grid>

            <Grid Grid.Row="1" Margin="22,14,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- colonne gauche : profil, chiffres, historique -->
                <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="14" Background="{StaticResource PanelBrush}" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:MonkaAvatar x:Name="Face" Grid.Column="0" Width="76" Height="84" />

                            <StackPanel Grid.Column="1" Margin="18,4,0,0">
                                <TextBlock x:Name="RankText" Foreground="{StaticResource ChalkBrush}"
                                           FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="PointsText" Foreground="{StaticResource WoodBrush}"
                                               FontSize="28" FontWeight="Bold" />
                                    <TextBlock x:Name="StreakText" Margin="14,0,0,0" VerticalAlignment="Bottom"
                                               Foreground="{StaticResource ChalkDimBrush}" FontSize="13" />
                                </StackPanel>

                                <Border Height="7" CornerRadius="4" Background="#12211C" Margin="0,12,0,0"
                                        x:Name="RankTrack" SizeChanged="OnRankTrackResized">
                                    <Border x:Name="RankFill" HorizontalAlignment="Left" CornerRadius="4"
                                            Background="{StaticResource WoodBrush}" />
                                </Border>
                                <TextBlock x:Name="NextRankText" Margin="0,7,0,0" FontSize="11"
                                           Foreground="{StaticResource ChalkDimBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,14,0,0">
                        <Border CornerRadius="12" Background="{StaticResource PanelBrush}" Padding="11,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="AccuracyText" Foreground="{StaticResource ChalkBrush}"
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="de réussite" Foreground="{StaticResource ChalkDimBrush}" FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="12" Background="{StaticResource PanelBrush}" Padding="11,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="AskedText" Foreground="{StaticResource ChalkBrush}"
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="questions" Foreground="{StaticResource ChalkDimBrush}" FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="12" Background="{StaticResource PanelBrush}" Padding="11,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="BestStreakText" Foreground="{StaticResource ChalkBrush}"
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="record" Foreground="{StaticResource ChalkDimBrush}" FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="12" Background="{StaticResource PanelBrush}" Padding="11,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="SpeedText" Foreground="{StaticResource ChalkBrush}"
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="temps moyen" Foreground="{StaticResource ChalkDimBrush}" FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="12" Background="{StaticResource PanelBrush}" Padding="14,12">
                            <StackPanel>
                                <TextBlock x:Name="ReviewText" Foreground="{StaticResource ChalkBrush}"
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="au carnet" Foreground="{StaticResource ChalkDimBrush}" FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- dix semaines d'activite, une case par jour -->
                    <Border Grid.Row="2" CornerRadius="14" Background="{StaticResource PanelBrush}" Margin="0,14,0,0"
                            Padding="18,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="StreakHeaderText" Foreground="{StaticResource ChalkDimBrush}"
                                           FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="StreakRecordText" HorizontalAlignment="Right"
                                           Foreground="{StaticResource ChalkDimBrush}" FontSize="11" />
                            </Grid>
                            <UniformGrid x:Name="CalendarGrid" Rows="7" Columns="26" Height="98" Margin="0,10,0,0" />
                            <!-- les chapitres qui coincent : le generateur les remet en avant tout seul -->
                            <TextBlock x:Name="WeakTopicsText" Margin="0,12,0,0" FontSize="11"
                                       Foreground="{StaticResource ChalkDimBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" CornerRadius="14" Background="{StaticResource PanelBrush}" Margin="0,14,0,0"
                            Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="HistoryTab" Content="Historique" Style="{StaticResource GhostButton}"
                                            Padding="12,5" FontSize="11" Click="OnTab" Tag="Historique" />
                                    <Button x:Name="TopicsTab" Content="Chapitres" Style="{StaticResource GhostButton}"
                                            Padding="12,5" FontSize="11" Margin="8,0,0,0" Click="OnTab" Tag="Chapitres" />
                                    <Button x:Name="ReviewTab" Content="Carnet" Style="{StaticResource GhostButton}"
                                            Padding="12,5" FontSize="11" Margin="8,0,0,0" Click="OnTab" Tag="Carnet" />
                                </StackPanel>
                                <TextBlock x:Name="TabHintText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource ChalkDimBrush}" FontSize="11" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9" Background="Transparent"
                                                  Tag="{Binding Key}" MouseLeftButtonUp="OnRowClick">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                                        VerticalAlignment="Center" Background="{Binding Color}" />
                                                <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                                    <TextBlock Text="{Binding Prompt}" Foreground="{StaticResource ChalkBrush}"
                                                               FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource ChalkDimBrush}"
                                                               FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Delta}" VerticalAlignment="Center"
                                                           Foreground="{Binding Color}" FontSize="13" FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- colonne droite : réglages -->
                <Border Grid.Column="1" CornerRadius="14" Background="{StaticResource PanelBrush}" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="RÉGLAGES" Foreground="{StaticResource ChalkDimBrush}"
                                           FontSize="11" FontWeight="SemiBold" />

                                <CheckBox x:Name="EnabledCheck" Style="{StaticResource ChalkCheck}" Margin="0,16,0,0"
                                          Content="Yvan est en service" Click="OnSettingChanged" />
                                <TextBlock x:Name="NextText" Foreground="{StaticResource ChalkDimBrush}" FontSize="11"
                                           Margin="50,4,0,0" />

                                <CheckBox x:Name="StartupCheck" Style="{StaticResource ChalkCheck}" Margin="0,16,0,0"
                                          Content="Démarrer avec Windows" Click="OnStartupChanged" />

                                <TextBlock Text="FRÉQUENCE" Foreground="{StaticResource ChalkDimBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,22,0,0" />
                                <TextBlock x:Name="FrequencyText" Foreground="{StaticResource ChalkBrush}" FontSize="13"
                                           Margin="0,8,0,0" />
                                <Slider x:Name="MinSlider" Style="{StaticResource ChalkSlider}" Minimum="1" Maximum="180" Margin="0,6,0,0"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFrequencyChanged" />
                                <Slider x:Name="MaxSlider" Style="{StaticResource ChalkSlider}" Minimum="1" Maximum="240" Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFrequencyChanged" />

                                <TextBlock Text="DIFFICULTÉ" Foreground="{StaticResource ChalkDimBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,22,0,0" />
                                <CheckBox x:Name="AutoLevelCheck" Style="{StaticResource ChalkCheck}" Margin="0,10,0,0"
                                          Content="Suivre mon rang" Click="OnSettingChanged" />
                                <TextBlock x:Name="LevelText" Foreground="{StaticResource ChalkBrush}" FontSize="13"
                                           Margin="0,10,0,0" />
                                <Slider x:Name="LevelSlider" Style="{StaticResource ChalkSlider}" Minimum="1" Maximum="8" Margin="0,6,0,0"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnLevelChanged" />
                                <CheckBox x:Name="ExamCheck" Style="{StaticResource ChalkCheck}" Margin="0,14,0,0"
                                          Content="Interros surprises" Click="OnSettingChanged" />

                                <TextBlock Text="SON" Foreground="{StaticResource ChalkDimBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,22,0,0" />
                                <CheckBox x:Name="IntroCheck" Style="{StaticResource ChalkCheck}" Margin="0,10,0,0"
                                          Content="La voix d'Yvan" Click="OnSettingChanged" />
                                <CheckBox x:Name="SfxCheck" Style="{StaticResource ChalkCheck}" Margin="0,10,0,0"
                                          Content="Bips de correction" Click="OnSettingChanged" />
                                <TextBlock x:Name="VolumeText" Foreground="{StaticResource ChalkBrush}" FontSize="13"
                                           Margin="0,10,0,0" />
                                <Slider x:Name="VolumeSlider" Style="{StaticResource ChalkSlider}" Minimum="0" Maximum="100" Margin="0,6,0,0"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnVolumeChanged" />

                                <TextBlock Text="TRANQUILLITÉ" Foreground="{StaticResource ChalkDimBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,22,0,0" />
                                <CheckBox x:Name="FullscreenCheck" Style="{StaticResource ChalkCheck}" Margin="0,10,0,0"
                                          Content="Se taire en plein écran" Click="OnSettingChanged" />
                                <CheckBox x:Name="QuietCheck" Style="{StaticResource ChalkCheck}" Margin="0,10,0,0"
                                          Content="Plage horaire calme" Click="OnSettingChanged" />
                                <TextBlock x:Name="QuietText" Foreground="{StaticResource ChalkBrush}" FontSize="13"
                                           Margin="0,10,0,0" />
                                <Slider x:Name="QuietFromSlider" Style="{StaticResource ChalkSlider}" Minimum="0" Maximum="23" Margin="0,6,0,0"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnQuietChanged" />
                                <Slider x:Name="QuietToSlider" Style="{StaticResource ChalkSlider}" Minimum="0" Maximum="23" Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnQuietChanged" />

                                <Button Content="Réinitialiser le score" Style="{StaticResource GhostButton}"
                                        Margin="0,26,0,0" HorizontalAlignment="Left" Click="OnReset" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <Button Content="Question maintenant" HorizontalAlignment="Stretch"
                                    Style="{StaticResource PrimaryButton}" Click="OnAskNow" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TrainButton" Grid.Column="0" Content="S'entraîner"
                                        Style="{StaticResource GhostButton}" Click="OnTrain" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="Bulletin"
                                        Style="{StaticResource GhostButton}" Click="OnBulletin" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Border>
        </Border>
    </Border>
</Window>
