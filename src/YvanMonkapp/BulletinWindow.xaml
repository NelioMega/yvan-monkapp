<Window x:Class="YvanMonkapp.BulletinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YvanMonkapp.Controls"
        Title="Yvan Monk'app" Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Card est la zone exportée en image : les boutons restent en dehors. -->
        <Border x:Name="Card" Grid.Row="0" CornerRadius="18" Background="{StaticResource BoardBrush}"
                BorderBrush="{StaticResource WoodBrush}" BorderThickness="1.5"
                MouseLeftButtonDown="OnDragArea">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <Border CornerRadius="17" Background="{StaticResource BoardPhotoBrush}">
                <Border CornerRadius="17" Background="#A61A2B24">
                    <StackPanel Margin="28,24,28,24">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:MonkaAvatar x:Name="Face" Grid.Column="0" Width="62" Height="62"
                                                  VerticalAlignment="Top" />

                            <StackPanel Grid.Column="1" Margin="16,0,10,0">
                                <TextBlock Text="Bulletin de la semaine" Foreground="{StaticResource ChalkBrush}"
                                           FontFamily="{StaticResource ChalkFont}" FontSize="24" />
                                <TextBlock x:Name="PeriodText" Foreground="{StaticResource ChalkDimBrush}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" CornerRadius="12" Background="#0F1C18" Padding="16,10"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock x:Name="NoteText" Foreground="{StaticResource WoodBrush}"
                                               FontSize="30" FontWeight="Bold" TextAlignment="Center" />
                                    <TextBlock Text="de moyenne" Foreground="{StaticResource ChalkDimBrush}"
                                               FontSize="10" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- en-tête du tableau -->
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CHAPITRE" Foreground="{StaticResource ChalkDimBrush}"
                                       FontSize="10" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="POSÉES" Foreground="{StaticResource ChalkDimBrush}"
                                       FontSize="10" FontWeight="SemiBold" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="RÉUSSITE" Foreground="{StaticResource ChalkDimBrush}"
                                       FontSize="10" FontWeight="SemiBold" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="NOTE" Foreground="{StaticResource ChalkDimBrush}"
                                       FontSize="10" FontWeight="SemiBold" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="" Foreground="{StaticResource ChalkDimBrush}"
                                       FontSize="10" TextAlignment="Right" />
                        </Grid>

                        <Border Height="1" Background="#2A4038" Margin="0,7,0,4" />

                        <ItemsControl x:Name="LineList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Topic}"
                                                   Foreground="{StaticResource ChalkBrush}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Asked}"
                                                   Foreground="{StaticResource ChalkDimBrush}" FontSize="13"
                                                   TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Success}"
                                                   Foreground="{StaticResource ChalkDimBrush}" FontSize="13"
                                                   TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Note}" FontSize="13"
                                                   FontWeight="SemiBold" TextAlignment="Right"
                                                   Foreground="{Binding Color}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Trend}" FontSize="12"
                                                   TextAlignment="Right" Foreground="{Binding TrendColor}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyText" Foreground="{StaticResource ChalkDimBrush}" FontSize="13"
                                   Margin="0,10,0,0" Visibility="Collapsed"
                                   Text="Aucune question cette semaine. Le cahier est vide." />

                        <Border Height="1" Background="#2A4038" Margin="0,10,0,0" />

                        <!-- appréciation du professeur -->
                        <Border CornerRadius="12" Background="#0F1C18" Padding="18,14" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="APPRÉCIATION" Foreground="{StaticResource ChalkDimBrush}"
                                           FontSize="10" FontWeight="SemiBold" />
                                <TextBlock x:Name="AppreciationText" Foreground="{StaticResource ChalkBrush}"
                                           FontSize="14" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="21" />
                                <TextBlock x:Name="FootnoteText" Foreground="{StaticResource WoodBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Yvan Monk'app" Foreground="#4E6B5F" FontFamily="{StaticResource ChalkFont}"
                                   FontSize="13" Margin="0,14,0,0" TextAlignment="Right" />
                    </StackPanel>
                </Border>
            </Border>
        </Border>

        <!-- Les boutons vivent hors de la carte pour rester absents de l'image exportée :
             il leur faut donc leur propre fond, sinon ils flottent sur le bureau. -->
        <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="12" Background="#E8101C18"
                BorderBrush="#2A4038" BorderThickness="1" Padding="12,10">
            <Grid>
                <Button Content="Exporter en image" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Click="OnExport" />
                <Button Content="Fermer" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</Window>
