<UserControl x:Class="YvanMonkapp.Controls.MonkaAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RenderTransformOrigin="0.5,0.5">

    <!-- Le contrôle entier peut sursauter : c'est le transform qui porte le rebond de joie. -->
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="Bounce" ScaleX="1" ScaleY="1" />
    </UserControl.RenderTransform>

    <!-- Le vrai Yvan quand tout va bien, Dark Yvan Monka quand ça se gâte.
         Les photos sont peintes dans des Ellipse : c'est ce qui les détoure en rond,
         un Border à coins arrondis ne rognerait pas son contenu. -->
    <Grid>
        <!-- Le halo change de couleur selon l'humeur : rouge quand ça se gâte, vert ou
             doré quand ça se passe bien. Les trois arrêts sont nommés pour être repeints
             d'un coup, plutôt que d'empiler un halo par couleur. -->
        <Ellipse x:Name="Glow" Margin="-6" Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowInner" Color="#00E2574C" Offset="0.55" />
                    <GradientStop x:Name="GlowMid" Color="#B0E2574C" Offset="0.78" />
                    <GradientStop x:Name="GlowOuter" Color="#00E2574C" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="Calm">
            <Ellipse.Fill>
                <ImageBrush ImageSource="pack://application:,,,/Assets/monka.png" Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="Dark" Opacity="0">
            <Ellipse.Fill>
                <ImageBrush ImageSource="pack://application:,,,/Assets/monka-dark.png" Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="Ring" Stroke="#C99A4F" StrokeThickness="2.5" />
    </Grid>
</UserControl>
